# Server values stay off the page. Encrypt those before staging.
# The two VITE_ names are public. Never put the database password or a service-role key in a VITE_ name.
# LIFE_LLM_PROTOCOL: anthropic | openai-compatible | openrouter
# openrouter posts to https://openrouter.ai/api/v1/chat/completions.
# Leave LIFE_LLM_ENDPOINT empty for that provider, or set the base https://openrouter.ai/api/v1.
# LIFE_LLM_MODEL is required. This repository does not choose a model.
# LIFE_LLM_API_KEY stays in this server env. Never prefix it with VITE_ or EXPO_PUBLIC_.
LIFE_LLM_PROTOCOL=
LIFE_LLM_ENDPOINT=
LIFE_LLM_MODEL=
LIFE_LLM_API_KEY=
LIFE_LLM_ALLOWED_USER_ID=
# Direct Postgres address parts. Encrypt these. Never prefix them with VITE_ or EXPO_PUBLIC_.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
