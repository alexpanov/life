{
  "name": "quest-os",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "description": "Shared TypeScript game core with web and iPhone interfaces.",
  "scripts": {
    "build": "vite build && node --import tsx scripts/finish-web.ts",
    "build:worker": "pnpm run build && node scripts/build-worker.mjs",
    "typecheck": "prisma generate && tsc --noEmit",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "start": "vite --host 127.0.0.1",
    "ios:bundle": "cd apps/iphone && expo export --platform ios --output-dir ../../native-dist",
    "ios:start": "cd apps/iphone && expo start --ios",
    "lint": "eslint packages apps scripts",
    "format": "prettier --write packages apps scripts tests/core tests/web tests/integration *.ts *.json",
    "test:unit": "vitest run tests/core",
    "test:integration": "vitest run --project integration",
    "test:dom": "vitest run tests/web",
    "test:browser": "playwright test",
    "install:ci": "pnpm install --frozen-lockfile",
    "check": "node scripts/check-release.mjs",
    "env:encrypt:development": "dotenvx encrypt -f .env.development",
    "env:encrypt:live": "dotenvx encrypt -f .env.live",
    "env:development": "dotenvx run -f .env.development --",
    "env:live": "dotenvx run -f .env.live --",
    "env:check": "node scripts/check-encrypted-env.mjs",
    "env:test": "node scripts/test-encrypted-env.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-slot": "1.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.117.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "effect": "4.0.2",
    "expo": "57.0.27",
    "expo-status-bar": "57.0.1",
    "lucide-react": "1.55.0",
    "pg": "8.23.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.89.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/eslint-parser": "7.29.9",
    "@babel/plugin-syntax-typescript": "7.29.7",
    "@dotenvx/dotenvx": "2.34.2",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
